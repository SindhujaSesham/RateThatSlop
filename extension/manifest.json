{
  "_changeNote": "Adapt extension name, description, icons, popup wiring, and Etsy content-script behavior here.",
  "manifest_version": 3,
  "name": "Etsy Pattern Detector",
  "version": "0.1.0",
  "description": "Detects potentially AI-generated sewing-pattern listing images locally in the browser.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "*://*.etsy.com/*"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.etsy.com/*"
      ],
      "js": [
        "src/content/index.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "../assets/icon16.png",
    "48": "../assets/icon48.png",
    "128": "../assets/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Etsy Pattern Detector"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}